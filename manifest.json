{
  "schemaVersion": 1,
  "id": "s3pp3ku.omavoid",
  "name": "Omarchy: Lunatic Fringe",
  "version": "0.4.0",
  "author": "s3pp3ku",
  "license": "MIT",
  "description": "Omarchy space-combat screensaver with a dropdown for screensaver selection and live icon/game palettes.",
