    "defaultSection": "right",
    "aliases": [
      "omavoid",
      "screensaver",
      "space",
      "lunatic fringe",
      "omarchy-lunatic-fringe"
    ],
    "schema": [
      {
        "key": "iconSize",
        "type": "integer",
        "label": "Icon size",
        "defaultValue": 12,
        "min": 8,
        "max": 18,
        "step": 1
      }
    ]
  }
}
